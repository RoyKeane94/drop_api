REVENUECAT_WEBHOOK_AUTH=replace-with-long-random-secret
REVENUECAT_SECRET_API_KEY=replace-with-revenuecat-secret-api-key
REVENUECAT_ENTITLEMENT_ID=household
# Audio prep — set exactly one to true (DENOISE_AUDIO wins if both are true).
DENOISE_AUDIO=false
FFMPEG_DENOISE=true
# Idle RSS restart (Railway): exit when RSS stays high with no traffic so the
# process restarts at a low baseline. Unset or 0 disables. Uses exit code 1
# so restartPolicyType=on_failure brings the service back.
MEMORY_IDLE_RESTART_MB=180
MEMORY_IDLE_RESTART_MS=300000
MEMORY_CHECK_INTERVAL_MS=60000
