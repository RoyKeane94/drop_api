REVENUECAT_WEBHOOK_AUTH=replace-with-long-random-secret
REVENUECAT_SECRET_API_KEY=replace-with-revenuecat-secret-api-key
REVENUECAT_ENTITLEMENT_ID=household
# Audio prep — set exactly one to true (DENOISE_AUDIO wins if both are true).
DENOISE_AUDIO=false
FFMPEG_DENOISE=true
# Transcribe in a short-lived child by default (keeps API RSS low).
# Set true only for local debugging of the Whisper path.
TRANSCRIBE_IN_PROCESS=false
TRANSCRIBE_WORKER_TIMEOUT_MS=120000
# Idle memory restart (Railway): exit when billable/cgroup memory stays high
# with no heavy work (captures/demo) so the process restarts at a low baseline.
# Unset or 0 disables. Uses exit code 1 so on_failure brings the service back.
MEMORY_IDLE_RESTART_MB=120
MEMORY_IDLE_RESTART_MS=300000
MEMORY_CHECK_INTERVAL_MS=60000
