generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id         String   @id @default(uuid())
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  users      User[]
  items      ListItem[]
  tags       HouseholdTag[]
}

model User {
  id             String    @id
  householdId    String?
  name           String?
  email          String?
  onboardingDone Boolean   @default(false)
  createdAt      DateTime  @default(now())

  household   Household? @relation(fields: [householdId], references: [id])
  ownedItems  ListItem[] @relation("owner")
  routedItems ListItem[] @relation("routedFrom")
}

model ListItem {
  id            String    @id @default(uuid())
  householdId   String
  ownerId       String
  fromUserId    String?
  type          String    // TASK | NOTE | SHARED_TASK | SHARED_NOTE | FOR_PARTNER
  displayType   String    // TASK | NOTE | SHARED TASK | SHARED NOTE | FOR [NAME]
  text          String
  rawTranscript String?
  done          Boolean   @default(false)
  doneAt        DateTime?
  dueDate       DateTime?
  reminderAt    DateTime?
  tags          String[]  @default([])
  createdAt     DateTime  @default(now())

  household     Household @relation(fields: [householdId], references: [id])
  owner         User      @relation("owner", fields: [ownerId], references: [id])
  fromUser      User?     @relation("routedFrom", fields: [fromUserId], references: [id])
}

model HouseholdTag {
  id          String   @id @default(uuid())
  householdId String
  name        String
  emoji       String?
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])

  @@unique([householdId, name])
}
